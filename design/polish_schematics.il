cv=dbOpenCellViewByType("rh_sram_lib" "sram6t" "schematic" "schematic" "a")
foreach(inst cv~>instances
  when(equal(inst~>libName "tsmc18rf")
    xy=inst~>xy
    dbCreateLabel(cv list("text" "drawing") list(xCoord(xy)-.55 yCoord(xy)+.8) sprintf(nil "%s  W=%s L=%s" inst~>name inst~>w inst~>l) "lowerLeft" "R0" "stick" .12)
  )
)
rhWireLabel(cv list(list(-2.25 2.8125) list(-2.25 1.1875)) "Q")
rhWireLabel(cv list(list(2.75 2.8125) list(2.75 1.1875)) "QN")
rhWireLabel(cv list(list(-2.25 4.1875) list(-2.25 4.75) list(2.75 4.75) list(2.75 4.1875)) "VDD")
rhWireLabel(cv list(list(-2.25 -0.1875) list(-2.25 -0.75) list(2.75 -0.75) list(2.75 -0.1875)) "VSS")
schCheck(cv)
dbSave(cv)
fprintf(fp "sram6t markers=%d\n" length(cv~>markers))
dbClose(cv)
