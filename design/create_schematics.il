rhDevice(cv "n" "N1" list(-2.5 0.5) "R0" 0.8 0.18 list(list("D" "Q") list("G" "QN") list("S" "VSS") list("B" "VSS")))
rhDevice(cv "n" "N2" list(2.5 0.5) "R0" 0.8 0.18 list(list("D" "QN") list("G" "Q") list("S" "VSS") list("B" "VSS")))
rhDevice(cv "n" "N3" list(-6 2) "R90" 0.4 0.18 list(list("D" "Q") list("G" "WL") list("S" "BL") list("B" "VSS")))
rhDevice(cv "n" "N4" list(6 2) "R90" 0.4 0.18 list(list("D" "QN") list("G" "WL") list("S" "BLB") list("B" "VSS")))
